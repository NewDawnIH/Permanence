    <dialog id="settingsModal">
        <div class="dialog-content">
            <h3 class="dialog-header">Settings</h3>
            <div class="input-group">
                <label for="favTagsInput">Highlight Favorite Tags (Comma separated)</label>
                <input type="text" id="favTagsInput" placeholder="e.g., 35, 49, 56">
                <p style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.5rem;">Entered tag numbers will be highlighted when viewing parsed FIX messages.</p>
            </div>
            <div class="dialog-actions">
                <button class="btn-secondary" onclick="fixrApp.closeSettings()">Cancel</button>
                <button class="btn-primary" onclick="fixrApp.saveSettings()">Save Configuration</button>
            </div>
        </div>
    </dialog>

    <dialog id="promptModal">
        <div class="dialog-content">
            <h3 class="dialog-header" id="promptTitle">Save Favorite</h3>
            <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.9rem;" id="promptMessage">Enter an alias for this FIX message:</p>
            <input type="text" id="promptInput" placeholder="e.g., AAPL New Order Single" onkeypress="if(event.key === 'Enter') fixrApp.confirmPrompt()">
            <div class="dialog-actions">
                <button class="btn-secondary" onclick="fixrApp.closePrompt()">Cancel</button>
                <button class="btn-primary" onclick="fixrApp.confirmPrompt()">Save</button>
            </div>
        </div>
    </dialog>

    <dialog id="confirmModal">
        <div class="dialog-content">
            <h3 class="dialog-header">Confirm Action</h3>
            <p id="confirmMessage" style="color: var(--text-main); margin-bottom: 1.5rem;"></p>
            <div class="dialog-actions">
                <button class="btn-secondary" onclick="fixrApp.closeConfirm()">Cancel</button>
                <button class="btn-danger" onclick="fixrApp.executeConfirm()">Delete</button>
            </div>
        </div>
    </dialog>

    <dialog id="alertModal">
        <div class="dialog-content">
            <h3 class="dialog-header">Notice</h3>
            <p id="alertMessage" style="color: var(--text-main); margin-bottom: 1.5rem;"></p>
            <div class="dialog-actions">
                <button class="btn-primary" onclick="fixrApp.closeAlert()">OK</button>
            </div>
        </div>
    </dialog>

