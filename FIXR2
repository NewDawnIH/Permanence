                const str = rawStr.trim();
                if (!str) return [];
                const delimiter = str.includes('|') ? '|' : (str.includes('^') ? '^' : '\x01');
                return str.split(delimiter).filter(Boolean);
            };

            const parseFix = (rawStr) => {
                const pairs = splitFixMessage(rawStr);
                const parsed = [];
                pairs.forEach(pair => {
                    const eqIndex = pair.indexOf('=');
                    if (eqIndex > 0) {
                        const tag = pair.substring(0, eqIndex).trim();
                        let value = pair.substring(eqIndex + 1).trim();
                        let name = FIX_DICTIONARY[tag] || 'Unknown';
                        
                        let translation = null;
                        if (tag === "35" && MSG_TYPES[value]) {
                            translation = MSG_TYPES[value];
                        } else if (VALUE_MAPS[tag] && VALUE_MAPS[tag][value]) {
                            translation = VALUE_MAPS[tag][value];
                        }

                        parsed.push({ tag, name, value, translation });
                    }
                });
                return parsed;
            };

            const escapeHTML = (str) => str.replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag])
            );

            const getDictionaryLink = (tag) => {
                return `https://www.onixs.biz/fix-dictionary/4.4/tagNum_${encodeURIComponent(tag)}.html`;
            };

            const showAlert = (msg) => {
                DOM.alertMessage.textContent = msg;
                DOM.alertModal.showModal();
            };
            const closeAlert = () => DOM.alertModal.close();

            const showConfirm = (msg, callback) => {
                DOM.confirmMessage.textContent = msg;
                state.confirmCallback = callback;
                DOM.confirmModal.showModal();
            };
            const closeConfirm = () => {
                DOM.confirmModal.close();
                state.confirmCallback = null;
            };
            const executeConfirm = () => {
                if (state.confirmCallback) state.confirmCallback();
                closeConfirm();
            };

            const showPrompt = (msg, callback) => {
                document.getElementById('promptMessage').textContent = msg;
                DOM.promptInput.value = '';
                state.promptCallback = callback;
                DOM.promptModal.showModal();
                setTimeout(() => DOM.promptInput.focus(), 10);
            };
            const closePrompt = () => {
                DOM.promptModal.close();
                state.promptCallback = null;
            };
            const confirmPrompt = () => {
                const val = DOM.promptInput.value.trim();
                if (state.promptCallback) state.promptCallback(val);
                closePrompt();
            };
            
            const openSettings = () => {
                DOM.favTagsInput.value = state.favoriteTags.join(', ');
                DOM.settingsModal.showModal();
            };
            const closeSettings = () => {
                DOM.settingsModal.close();
            };
            const saveSettings = () => {
                const rawTags = DOM.favTagsInput.value;
                const parsedTags = rawTags.split(',').map(t => t.trim()).filter(Boolean);
                state.favoriteTags = parsedTags;
                localStorage.setItem('fixer_fav_tags', parsedTags.join(','));
                closeSettings();
                
                if (state.currentParsedView) {
                    processView();
                }
            };

            /* ==========================================================================
               UI RENDERING
               ========================================================================== */
            
            const renderFavorites = () => {
                if (state.favorites.length === 0) {
                    DOM.favoritesList.innerHTML = `<div class="empty-state" style="padding: 1rem; font-size: 0.85rem;">No saved favorites yet.</div>`;
                    return;
                }

                DOM.favoritesList.innerHTML = state.favorites.map((fav, index) => `
                    <div class="favorite-item" onclick="fixrApp.loadFavorite(${index})">
                        <div>
                            <div class="favorite-item-title">${escapeHTML(fav.alias)}</div>
                            <div class="favorite-item-date">${new Date(fav.date).toLocaleDateString()}</div>
                        </div>
                        <button class="btn-icon" onclick="event.stopPropagation(); fixrApp.deleteFavorite(${index})" title="Delete">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                        </button>
                    </div>
                `).join('');
            };

            /* ==========================================================================
               BUSINESS LOGIC
               ========================================================================== */
            
            const processView = () => {
                const raw = DOM.viewInput.value;
                const parsed = parseFix(raw);

                if (parsed.length === 0) {
                    DOM.viewResults.innerHTML = `<div class="empty-state">No valid FIX tags found. Please check format.</div>`;
                    DOM.btnSaveFav.style.display = 'none';
                    state.currentParsedView = null;
                    return;
                }

                state.currentParsedView = raw; 

                let html = `
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Tag</th>
                                    <th>Field Name</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                `;

                parsed.forEach(item => {
                    const isFav = state.favoriteTags.includes(item.tag);
                    const trClass = isFav ? 'highlight-tag' : '';
                    
                    html += `
                        <tr class="${trClass}">
                            <td class="tag-cell">
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    ${escapeHTML(item.tag)}
                                    <a href="${getDictionaryLink(item.tag)}" target="_blank" title="View in FIX Dictionary" class="tag-link">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                    </a>
                                </div>
                            </td>
                            <td class="name-cell">${escapeHTML(item.name)}</td>
                            <td class="val-cell">
                                ${escapeHTML(item.value)}
                                ${item.translation ? `<span class="tag-translation">(${escapeHTML(item.translation)})</span>` : ''}
                            </td>
                        </tr>
                    `;
                });

                html += `</tbody></table></div>`;
                DOM.viewResults.innerHTML = html;
                DOM.btnSaveFav.style.display = 'inline-block';
            };

            const loadExample = () => {
                DOM.viewInput.value = "8=FIX.4.2|9=154|35=D|49=CLIENT1|56=BROKER|34=102|52=20231024-10:00:00|11=ORD9982|54=1|38=500|40=2|44=150.25|55=AAPL|59=0|10=223|";
                processView();
            };

            const promptSaveFavorite = () => {
                if (!state.currentParsedView) return;
                showPrompt("Enter an alias for this saved message:", (alias) => {
                    if (alias) saveFavorite(alias);
                });
            };

            const saveFavorite = (alias) => {
                state.favorites.push({
                    alias: alias,
                    raw: state.currentParsedView,
                    date: new Date().toISOString()
                });
                localStorage.setItem('fixer_favorites', JSON.stringify(state.favorites));
                renderFavorites();
                showAlert(`Message saved as "${alias}"`);
            };

            const loadFavorite = (index) => {
                const fav = state.favorites[index];
                if (fav) {
                    DOM.viewInput.value = fav.raw;
                    processView();
                }
            };

            const deleteFavorite = (index) => {
                showConfirm("Are you sure you want to permanently delete this saved message?", () => {
                    state.favorites.splice(index, 1);
                    localStorage.setItem('fixer_favorites', JSON.stringify(state.favorites));
                    renderFavorites();
                });
            };

            return {
                init: () => { renderFavorites(); },
                processView,
                loadExample,
                promptSaveFavorite,
                closePrompt,
                confirmPrompt,
                loadFavorite,
                deleteFavorite,
                closeAlert,
                showConfirm,
                closeConfirm,
                executeConfirm,
                openSettings,
                closeSettings,
                saveSettings
            };

        })();

        document.addEventListener('DOMContentLoaded', fixrApp.init);
    </script>
</div>
