<div id="as400-simulator-wrapper" tabindex="0">
    <style>
        #as400-simulator-wrapper {
            --bg-color: #121212;
            --panel-bg: #1e1e1e;
            --border-color: #333;
            --text-color: #f0f0f0;
            --accent-color: #0066cc;
            --accent-hover: #0077ee;
            --danger-color: #cc0000;
            --danger-hover: #ee0000;
            --select-color: rgba(255, 255, 255, 0.3);

            margin: 0;
            padding: 0;
            height: 800px;
            width: 100%;
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            position: relative;
            outline: none; /* Removes the default blue focus ring */
            text-align: left;
        }

        #as400-simulator-wrapper * {
            box-sizing: border-box;
        }

        #as400-simulator-wrapper .app-container {
            display: flex;
            height: 100%;
            width: 100%;
        }

        /* Sidebar Styling */
        #as400-simulator-wrapper .sidebar {
            width: 280px;
            background-color: var(--panel-bg);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding-bottom: 20px;
        }

        #as400-simulator-wrapper .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid var(--border-color);
            background: #171717;
            text-align: center;
        }

        #as400-simulator-wrapper .sidebar-header h1 {
            margin: 0;
            font-size: 20px;
            letter-spacing: 1px;
            color: #00FF00;
            text-transform: uppercase;
            line-height: 1.2;
        }

        #as400-simulator-wrapper .panel {
            padding: 20px;
            border-bottom: 1px solid var(--border-color);
        }

        #as400-simulator-wrapper .panel h3 {
            margin: 0 0 15px 0;
            font-size: 14px;
            text-transform: uppercase;
            color: #888;
            letter-spacing: 1px;
            line-height: 1.2;
        }

        /* Controls */
        #as400-simulator-wrapper .color-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        #as400-simulator-wrapper .color-swatch {
            height: 30px;
            border-radius: 6px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: 0.2s;
        }

        #as400-simulator-wrapper .color-swatch:hover {
            transform: scale(1.1);
        }

        #as400-simulator-wrapper .color-swatch.active {
            border-color: #fff;
            box-shadow: 0 0 10px rgba(255,255,255,0.4);
        }

        #as400-simulator-wrapper .btn-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 10px;
        }

        #as400-simulator-wrapper .btn {
            background-color: #2a2a2a;
            color: var(--text-color);
            border: 1px solid var(--border-color);
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 13px;
            transition: all 0.2s;
            text-align: center;
            user-select: none;
            line-height: normal;
        }

        #as400-simulator-wrapper .btn:hover { background-color: #3a3a3a; }
        #as400-simulator-wrapper .btn.active { background-color: var(--accent-color); border-color: var(--accent-hover); color: white; }
        #as400-simulator-wrapper .btn-full { width: 100%; box-sizing: border-box; margin-bottom: 10px; }
        #as400-simulator-wrapper .btn-primary { background-color: var(--accent-color); border-color: var(--accent-hover); }
        #as400-simulator-wrapper .btn-primary:hover { background-color: var(--accent-hover); }
        #as400-simulator-wrapper .btn-danger { background-color: var(--danger-color); border-color: var(--danger-hover); }
        #as400-simulator-wrapper .btn-danger:hover { background-color: var(--danger-hover); }

        /* Main Workspace */
        #as400-simulator-wrapper .main-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #111;
            position: relative;
        }

        #as400-simulator-wrapper .terminal-bezel {
            background: #222;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8), inset 0 1px 1px rgba(255,255,255,0.1);
        }

        #as400-simulator-wrapper .terminal {
            display: grid !important;
            grid-template-columns: repeat(80, 12px) !important;
            grid-template-rows: repeat(24, 24px) !important;
            gap: 0 !important;
            background: #000;
            border: 2px solid #000;
            box-shadow: inset 0 0 20px rgba(0,255,0,0.05);
            user-select: none;
            cursor: text;
        }
        
        #as400-simulator-wrapper .terminal.selection-mode {
            cursor: crosshair;
        }

        /* Hardened cell styles to prevent Confluence CSS bleed */
        #as400-simulator-wrapper .cell {
            width: 12px !important;
            height: 24px !important;
            font-family: 'Courier New', Courier, monospace !important;
            font-size: 20px !important;
            line-height: 24px !important;
            text-align: center !important;
            display: inline-block !important;
            white-space: pre !important;
            position: relative !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* Area Brush Highlight */
        #as400-simulator-wrapper .cell.selected {
            box-shadow: inset 0 0 0 20px var(--select-color) !important;
        }

        /* Animations and Text Styles */
        #as400-simulator-wrapper .terminal.global-blink-off .blink { opacity: 0; }
        
        #as400-simulator-wrapper .underline { text-decoration: underline; }

        #as400-simulator-wrapper .cell.underscore {
            color: transparent !important;
        }
        #as400-simulator-wrapper .cell.underscore::after {
            content: '';
            position: absolute;
            bottom: 2px;
            left: 0;
            right: 0;
            height: 2px;
            background-color: var(--underscore-color);
        }

        /* Cursor Implementation */
        #as400-simulator-wrapper .cell.cursor::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(255,255,255,0.5);
            z-index: 10;
            pointer-events: none;
            animation: cursor-blink 1s step-end infinite;
        }
        @keyframes cursor-blink {
            0%, 49% { opacity: 1; }
            50%, 100% { opacity: 0; }
        }
        #as400-simulator-wrapper .terminal.hide-cursor .cell.cursor::before { display: none; }

        /* Status Bar */
        #as400-simulator-wrapper .status-bar {
            margin-top: 20px;
            background: #1e1e1e;
            padding: 10px 20px;
            border-radius: 20px;
            font-family: monospace;
            font-size: 14px;
            color: #aaa;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            border: 1px solid #333;
            transition: opacity 0.3s;
            line-height: normal;
        }
        #as400-simulator-wrapper .status-bar.hidden { opacity: 0; pointer-events: none; }
        #as400-simulator-wrapper .status-highlight { color: #fff; font-weight: bold; }

        /* Modals */
        #as400-simulator-wrapper .modal-overlay {
            position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(3px);
            display: none; align-items: center; justify-content: center;
            z-index: 1000;
        }
        #as400-simulator-wrapper .modal-overlay.active { display: flex; }
        #as400-simulator-wrapper .modal-content {
            background: #1e1e1e; padding: 25px; border-radius: 12px;
            width: 400px; max-width: 90%;
            box-shadow: 0 15px 40px rgba(0,0,0,0.5);
            border: 1px solid #333;
        }
        #as400-simulator-wrapper .modal-content h3 { margin-top: 0; border-bottom: 1px solid #333; padding-bottom: 15px; font-size: 18px; line-height: 1.2;}
        #as400-simulator-wrapper .form-group { margin-bottom: 15px; }
        #as400-simulator-wrapper .form-group label { display: block; margin-bottom: 8px; font-size: 13px; color: #aaa; }
        #as400-simulator-wrapper .form-group input, 
        #as400-simulator-wrapper .form-group textarea {
            width: 100%; padding: 10px; box-sizing: border-box; background: #111;
            border: 1px solid #444; color: #fff; border-radius: 6px; font-family: monospace;
            line-height: 1.4;
        }
        #as400-simulator-wrapper .form-group textarea { height: 120px; resize: none; }
        #as400-simulator-wrapper .modal-actions { text-align: right; margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px; }
        
        #as400-simulator-wrapper .save-list { max-height: 200px; overflow-y: auto; background: #111; border: 1px solid #333; border-radius: 6px; padding: 5px; }
        #as400-simulator-wrapper .save-item { display: flex; justify-content: space-between; align-items: center; padding: 10px; border-bottom: 1px solid #222; }
        #as400-simulator-wrapper .save-item:last-child { border-bottom: none; }
        #as400-simulator-wrapper .save-item span { font-weight: bold; }
        #as400-simulator-wrapper .save-item div { display: flex; gap: 5px; }

        /* Toast Notifications */
        #as400-simulator-wrapper .toast {
            position: absolute; bottom: -60px; left: 50%; transform: translateX(-50%);
            background: #0066cc; color: #fff; padding: 12px 24px; border-radius: 30px;
            font-weight: bold; font-size: 14px; box-shadow: 0 10px 20px rgba(0,0,0,0.3);
            transition: bottom 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 2000;
        }
        #as400-simulator-wrapper .toast.show { bottom: 30px; }

    </style>

    <div class="app-container">
        <div class="sidebar">
            <div class="sidebar-header">
                <h1>Options</h1>
            </div>

            <div class="panel">
                <h3>Terminal Colors</h3>
                <div class="color-grid">
                    <div class="color-swatch active" style="background-color: #00FF00" data-color="#00FF00" title="Green"></div>
                    <div class="color-swatch" style="background-color: #FFFFFF" data-color="#FFFFFF" title="White"></div>
                    <div class="color-swatch" style="background-color: #FF0000" data-color="#FF0000" title="Red"></div>
                    <div class="color-swatch" style="background-color: #00FFFF" data-color="#00FFFF" title="Turquoise"></div>
                    <div class="color-swatch" style="background-color: #FFFF00" data-color="#FFFF00" title="Yellow"></div>
                    <div class="color-swatch" style="background-color: #FF00FF" data-color="#FF00FF" title="Pink"></div>
                    <div class="color-swatch" style="background-color: #3366FF" data-color="#3366FF" title="Blue"></div>
                </div>
            </div>

            <div class="panel">
                <h3>Text Decorations</h3>
                <div class="btn-grid">
                    <button class="btn" id="btn-reverse" onclick="toggleDecoration('reverse', this)">Reverse</button>
                    <button class="btn" id="btn-underline" onclick="toggleDecoration('underline', this)">Underline</button>
                </div>
                <button class="btn btn-full" id="btn-blink" onclick="toggleDecoration('blink', this)">Blink</button>
            </div>

            <div class="panel">
                <h3>Area Brush</h3>
                <button class="btn btn-full" id="btn-select-toggle" onclick="toggleSelectionMode()">Brush Mode: OFF</button>
                <p style="font-size: 11px; color: #888; margin: 5px 0 0 0; line-height: 1.3;">Toggle ON to drag & select. Then apply colors, styles, type a letter to fill, or press Backspace to clear.</p>
            </div>

            <div class="panel">
                <h3>Entry & View Modes</h3>
                <button class="btn btn-full" id="btn-entry-mode" onclick="toggleEntryMode()">Mode: Overwrite (Fixed)</button>
                <button class="btn btn-full active" id="btn-cursor-toggle" onclick="toggleCursorVisibility()">Show Cursor Location</button>
            </div>

            <div class="panel">
                <h3>File & Output</h3>
                <button class="btn btn-full btn-primary" onclick="openSaveModal()">Save Design Local</button>
                <button class="btn btn-full" onclick="openLoadModal()">Load Design Local</button>
                <div style="height: 10px;"></div>
                <button class="btn btn-full" onclick="exportPNG()">Download PNG</button>
                <div class="btn-grid">
                    <button class="btn" onclick="openExportModal()">Export Code</button>
                    <button class="btn" onclick="openImportModal()">Import Code</button>
                </div>
            </div>

            <div class="panel" style="border-bottom: none;">
                <h3>Workspace</h3>
                <button class="btn btn-full" onclick="loadBase64(defaultScreenBase64)">Reset to Default</button>
                <button class="btn btn-full btn-danger" onclick="openClearModal()">Clear to Blank</button>
            </div>
        </div>

        <div class="main-area">
            <div class="terminal-bezel">
                <div id="terminal" class="terminal"></div>
            </div>
            
            <div id="status-bar" class="status-bar">
                Row: <span id="stat-r" class="status-highlight">01</span> &nbsp;|&nbsp; 
                Col: <span id="stat-c" class="status-highlight">01</span> &nbsp;|&nbsp; 
                Mode: <span id="stat-mode" class="status-highlight">Overwrite</span>
            </div>
        </div>
    </div>

    <div id="modal-save" class="modal-overlay">
        <div class="modal-content">
            <h3>Save Design</h3>
            <div class="form-group">
                <label>Save Name</label>
                <input type="text" id="save-name-input" placeholder="e.g. Main Menu Layout">
            </div>
            <div class="modal-actions">
                <button class="btn" onclick="closeModal('modal-save')">Cancel</button>
                <button class="btn btn-primary" onclick="saveDesign()">Save</button>
            </div>
        </div>
    </div>

    <div id="modal-load" class="modal-overlay">
        <div class="modal-content">
            <h3>Load Design</h3>
            <div class="save-list" id="load-list">
                </div>
            <div class="modal-actions">
                <button class="btn" onclick="closeModal('modal-load')">Close</button>
            </div>
        </div>
    </div>

    <div id="modal-export" class="modal-overlay">
        <div class="modal-content">
            <h3>Export Encoded String</h3>
            <div class="form-group">
                <label>Copy this string to share your layout</label>
                <textarea id="export-textarea" readonly></textarea>
            </div>
            <div class="modal-actions">
                <button class="btn" onclick="closeModal('modal-export')">Close</button>
                <button class="btn btn-primary" onclick="copyExport()">Copy to Clipboard</button>
            </div>
        </div>
    </div>

    <div id="modal-import" class="modal-overlay">
        <div class="modal-content">
            <h3>Import Encoded String</h3>
            <div class="form-group">
                <label>Paste an encoded layout string below</label>
                <textarea id="import-textarea" placeholder="Paste Base64 string here..."></textarea>
            </div>
            <div class="modal-actions">
                <button class="btn" onclick="closeModal('modal-import')">Cancel</button>
                <button class="btn btn-primary" onclick="importCode()">Load Layout</button>
            </div>
        </div>
    </div>

    <div id="modal-clear" class="modal-overlay">
        <div class="modal-content">
            <h3>Clear Screen?</h3>
            <p style="color: #ccc; font-size: 14px;">Are you sure you want to clear the entire screen? Unsaved progress will be lost.</p>
            <div class="modal-actions">
                <button class="btn" onclick="closeModal('modal-clear')">Cancel</button>
                <button class="btn btn-danger" onclick="clearScreen()">Clear Everything</button>
            </div>
        </div>
    </div>

    <div id="toast" class="toast">Action successful!</div>

    <script>
        // ==========================================
        // HARDCODED INITIAL STATE
        // Paste your base64 encoded screen string here
        // ==========================================
        const defaultScreenBase64 = "";

        // Constants
        const ROWS = 24;
        const COLS = 80;

        // State Variables
        let grid = [];
        let cellElements = [];
        let cursorR = 0;
        let cursorC = 0;
        let insertMode = false;
        let showCursor = true;
        
        // Area Brush Variables
        let isSelectionMode = false;
        let isDragging = false;
        let selStart = null;
        let selEnd = null;

        // Active Drawing Styles
        let activeColor = '#00FF00';
        let activeReverse = false;
        let activeUnderline = false;
        let activeBlink = false;

        // DOM References
        const wrapperEl = document.getElementById('as400-simulator-wrapper');
        const terminalEl = document.getElementById('terminal');
        const statR = document.getElementById('stat-r');
        const statC = document.getElementById('stat-c');
        const statMode = document.getElementById('stat-mode');
        const statusBar = document.getElementById('status-bar');

        // Initialization
        function init() {
            buildGridDOM();
            if (defaultScreenBase64) {
                try {
                    loadBase64(defaultScreenBase64);
                } catch(e) {
                    console.error("Failed to load default base64");
                    initBlankGrid();
                }
            } else {
                initBlankGrid();
            }
            setupEvents();
            setCursor(0, 0);

            // Synchronize blinking letters globally
            setInterval(() => {
                terminalEl.classList.toggle('global-blink-off');
            }, 500);
        }

        function initBlankGrid() {
            grid = Array.from({length: ROWS}, () => 
                Array.from({length: COLS}, () => createEmptyCell())
            );
            renderAll();
        }

        function buildGridDOM() {
            terminalEl.innerHTML = '';
            cellElements = [];
            for(let r=0; r<ROWS; r++){
                let rowEls = [];
                for(let c=0; c<COLS; c++){
                    let span = document.createElement('span');
                    span.className = 'cell';
                    span.dataset.r = r;
                    span.dataset.c = c;
                    terminalEl.appendChild(span);
                    rowEls.push(span);
                }
                cellElements.push(rowEls);
            }
        }

        function createCellObject(char) {
            return {
                char: char,
                color: activeColor,
                reverse: activeReverse,
                underline: activeUnderline,
                blink: activeBlink
            };
        }

        function createEmptyCell() {
            return {
                char: ' ',
                color: '#00FF00',
                reverse: false,
                underline: false,
                blink: false
            };
        }

        // Render Logic
        function renderAll() {
            for(let r=0; r<ROWS; r++){
                for(let c=0; c<COLS; c++){
                    updateCellDOM(r, c);
                }
            }
        }

        function renderRow(r) {
            for(let c=0; c<COLS; c++) updateCellDOM(r, c);
        }

        function updateCellDOM(r, c) {
            let cell = grid[r][c];
            let el = cellElements[r][c];
            
            let fg = cell.color;
            let bg = '#000';
            if (cell.reverse) { bg = cell.color; fg = '#000'; }
            
            el.style.backgroundColor = bg;
            el.style.color = cell.char === '_' ? 'transparent' : fg;
            el.style.setProperty('--underscore-color', fg);
            
            let classes = ['cell'];
            if (cell.blink) classes.push('blink');
            if (cell.underline && cell.char !== '_') classes.push('underline');
            if (cell.char === '_') classes.push('underscore'); 
            if (r === cursorR && c === cursorC) classes.push('cursor');
            
            // Preserve selection highlighting
            if (selStart && selEnd) {
                let b = getSelectionBounds();
                if (r >= b.rMin && r <= b.rMax && c >= b.cMin && c <= b.cMax) {
                    classes.push('selected');
                }
            }

            el.className = classes.join(' ');
            el.textContent = cell.char;
        }

        // Cursor Logic
        function setCursor(r, c) {
            let oldR = cursorR, oldC = cursorC;
            cursorR = Math.max(0, Math.min(ROWS - 1, r));
            cursorC = Math.max(0, Math.min(COLS - 1, c));
            
            if (oldR !== cursorR || oldC !== cursorC) {
                updateCellDOM(oldR, oldC);
            }
            updateCellDOM(cursorR, cursorC);
            
            statR.textContent = (cursorR + 1).toString().padStart(2, '0');
            statC.textContent = (cursorC + 1).toString().padStart(2, '0');
        }

        window.toggleCursorVisibility = function() {
            showCursor = !showCursor;
            const btn = document.getElementById('btn-cursor-toggle');
            btn.classList.toggle('active', showCursor);
            btn.textContent = showCursor ? "Show Cursor Location" : "Hide Cursor Location";
            
            if (showCursor) {
                terminalEl.classList.remove('hide-cursor');
                statusBar.classList.remove('hidden');
            } else {
                terminalEl.classList.add('hide-cursor');
                statusBar.classList.add('hidden');
            }
        }

        window.toggleEntryMode = function() {
            insertMode = !insertMode;
            const btn = document.getElementById('btn-entry-mode');
            btn.textContent = insertMode ? "Mode: Insert (Dynamic)" : "Mode: Overwrite (Fixed)";
            statMode.textContent = insertMode ? "Insert" : "Overwrite";
        }

        // --- Area Brush Logic ---
        window.toggleSelectionMode = function() {
            isSelectionMode = !isSelectionMode;
            const btn = document.getElementById('btn-select-toggle');
            if (isSelectionMode) {
                btn.textContent = "Brush Mode: ON";
                btn.classList.add('active');
                terminalEl.classList.add('selection-mode');
            } else {
                btn.textContent = "Brush Mode: OFF";
                btn.classList.remove('active');
                terminalEl.classList.remove('selection-mode');
                clearSelection();
            }
        }

        function clearSelection() {
            selStart = null;
            selEnd = null;
            renderAll();
        }

        function getSelectionBounds() {
            if (!selStart || !selEnd) return null;
            return {
                rMin: Math.min(selStart.r, selEnd.r),
                rMax: Math.max(selStart.r, selEnd.r),
                cMin: Math.min(selStart.c, selEnd.c),
                cMax: Math.max(selStart.c, selEnd.c)
            };
        }

        function applyToSelection(actionFn) {
            const b = getSelectionBounds();
            if (!b) return false;
            for(let r=b.rMin; r<=b.rMax; r++){
                for(let c=b.cMin; c<=b.cMax; c++){
                    actionFn(grid[r][c]);
                }
            }
            renderAll();
            return true;
        }

        // Formatting Logic
        document.querySelectorAll('.color-swatch').forEach(sw => {
            sw.addEventListener('click', (e) => {
                document.querySelector('.color-swatch.active').classList.remove('active');
                e.target.classList.add('active');
                activeColor = e.target.dataset.color;
                
                // If an area is selected, apply color immediately
                if (selStart && selEnd) {
                    applyToSelection(cell => cell.color = activeColor);
                }
            });
        });

        window.toggleDecoration = function(type, btn) {
            if (type === 'reverse') activeReverse = !activeReverse;
            if (type === 'underline') activeUnderline = !activeUnderline;
            if (type === 'blink') activeBlink = !activeBlink;
            btn.classList.toggle('active');

            // If an area is selected, apply the newly toggled state immediately
            if (selStart && selEnd) {
                applyToSelection(cell => {
                    if (type === 'reverse') cell.reverse = activeReverse;
                    if (type === 'underline') cell.underline = activeUnderline;
                    if (type === 'blink') cell.blink = activeBlink;
                });
            }
        }

        // Keyboard & Mouse Events
        function setupEvents() {
            terminalEl.addEventListener('mousedown', (e) => {
                // FORCE FOCUS onto the wrapper so keystrokes register here instead of on the confluence page
                wrapperEl.focus();

                let el = e.target.closest('.cell');
                if (el) {
                    let r = parseInt(el.dataset.r);
                    let c = parseInt(el.dataset.c);
                    if (isSelectionMode) {
                        isDragging = true;
                        selStart = {r, c};
                        selEnd = {r, c};
                        renderAll();
                    } else {
                        clearSelection();
                        setCursor(r, c);
                    }
                }
            });

            terminalEl.addEventListener('mousemove', (e) => {
                if (isDragging && isSelectionMode) {
                    let el = e.target.closest('.cell');
                    if (el) {
                        let r = parseInt(el.dataset.r);
                        let c = parseInt(el.dataset.c);
                        if (selEnd.r !== r || selEnd.c !== c) {
                            selEnd = {r, c};
                            renderAll();
                        }
                    }
                }
            });

            document.addEventListener('mouseup', () => {
                isDragging = false;
            });

            // Bind explicitly to the wrapper instead of the document
            wrapperEl.addEventListener('keydown', (e) => {
                // STOP EVENT BUBBLING TO CONFLUENCE
                e.stopPropagation();

                if (document.querySelector('.modal-overlay.active')) return;
                
                if (e.ctrlKey || e.metaKey || e.altKey) return;
                
                if (['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' ','Backspace','Delete','Enter','Tab', 'Escape'].includes(e.key)) {
                    e.preventDefault();
                }

                if (e.key === 'Escape') {
                    clearSelection();
                    return;
                }
                
                if (e.key === 'ArrowUp') setCursor(cursorR - 1, cursorC);
                else if (e.key === 'ArrowDown') setCursor(cursorR + 1, cursorC);
                else if (e.key === 'ArrowLeft') setCursor(cursorR, cursorC - 1);
                else if (e.key === 'ArrowRight') setCursor(cursorR, cursorC + 1);
                else if (e.key === 'Enter') setCursor(cursorR + 1, 0);
                else if (e.key === 'Tab') setCursor(cursorR, Math.min(COLS-1, cursorC + 4));
                else if (e.key === 'Backspace' || e.key === 'Delete') {
                    // Brush Fill Override
                    if (selStart && selEnd) {
                        applyToSelection(cell => {
                            Object.assign(cell, createEmptyCell());
                        });
                        return; 
                    }

                    if (e.key === 'Backspace' && cursorC > 0) {
                        setCursor(cursorR, cursorC - 1);
                        if (insertMode) {
                            grid[cursorR].splice(cursorC, 1);
                            grid[cursorR].push(createEmptyCell());
                        } else {
                            grid[cursorR][cursorC] = createEmptyCell();
                        }
                        renderRow(cursorR);
                    } else if (e.key === 'Delete') {
                        if (insertMode) {
                            grid[cursorR].splice(cursorC, 1);
                            grid[cursorR].push(createEmptyCell());
                        } else {
                            grid[cursorR][cursorC] = createEmptyCell();
                        }
                        renderRow(cursorR);
                    }
                }
                else if (e.key.length === 1) {
                    // Brush Fill Override
                    if (selStart && selEnd) {
                        applyToSelection(cell => {
                            cell.char = e.key;
                            cell.color = activeColor;
                            cell.reverse = activeReverse;
                            cell.underline = activeUnderline;
                            cell.blink = activeBlink;
                        });
                        return;
                    }

                    if (insertMode) {
                        grid[cursorR].splice(cursorC, 0, createCellObject(e.key));
                        grid[cursorR].pop();
                    } else {
                        grid[cursorR][cursorC] = createCellObject(e.key);
                    }
                    renderRow(cursorR);
                    setCursor(cursorR, cursorC + 1);
                }
            });
        }

        // Modal System
        window.openModal = function(id) { document.getElementById(id).classList.add('active'); }
        window.closeModal = function(id) { document.getElementById(id).classList.remove('active'); }
        function showToast(msg) {
            const t = document.getElementById('toast');
            t.textContent = msg; t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 3000);
        }

        // Features
        window.openClearModal = function() { openModal('modal-clear'); }
        window.clearScreen = function() {
            initBlankGrid();
            setCursor(0, 0);
            closeModal('modal-clear');
            showToast("Screen cleared!");
        }

        window.openSaveModal = function() {
            document.getElementById('save-name-input').value = '';
            openModal('modal-save');
            document.getElementById('save-name-input').focus();
        }
        
        window.saveDesign = function() {
            const name = document.getElementById('save-name-input').value.trim();
            if(!name) return;
            const saves = JSON.parse(localStorage.getItem('as400_saves') || '{}');
            saves[name] = grid;
            localStorage.setItem('as400_saves', JSON.stringify(saves));
            closeModal('modal-save');
            showToast("Design saved locally!");
        }

        window.openLoadModal = function() {
            const list = document.getElementById('load-list');
            list.innerHTML = '';
            const saves = JSON.parse(localStorage.getItem('as400_saves') || '{}');
            const keys = Object.keys(saves);
            if(keys.length === 0) {
                list.innerHTML = '<div style="padding: 10px; color: #888;">No saved designs found.</div>';
            } else {
                keys.forEach(k => {
                    const div = document.createElement('div');
                    div.className = 'save-item';
                    div.innerHTML = `
                        <span>${k}</span>
                        <div>
                            <button class="btn btn-primary" style="padding: 4px 8px; font-size: 12px;" onclick="loadDesign('${k.replace(/'/g, "\\'")}')">Load</button>
                            <button class="btn btn-danger" style="padding: 4px 8px; display: flex; align-items: center; justify-content: center;" onclick="deleteDesign('${k.replace(/'/g, "\\'")}')" title="Delete">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                            </button>
                        </div>
                    `;
                    list.appendChild(div);
                });
            }
            openModal('modal-load');
        }

        window.loadDesign = function(name) {
            const saves = JSON.parse(localStorage.getItem('as400_saves') || '{}');
            if(saves[name]) {
                grid = saves[name];
                renderAll();
                setCursor(0, 0);
                closeModal('modal-load');
                showToast("Design loaded!");
            }
        }

        window.deleteDesign = function(name) {
            const saves = JSON.parse(localStorage.getItem('as400_saves') || '{}');
            delete saves[name];
            localStorage.setItem('as400_saves', JSON.stringify(saves));
            openLoadModal(); // refresh list
        }

        // Export/Import Base64 Logic
        function generateBase64() {
            let compressed = [];
            for(let r=0; r<ROWS; r++){
                for(let c=0; c<COLS; c++){
                    let cell = grid[r][c];
                    if(cell.char !== ' ' || cell.color !== '#00FF00' || cell.reverse || cell.underline || cell.blink) {
                        compressed.push({r, c, ...cell});
                    }
                }
            }
            return btoa(encodeURIComponent(JSON.stringify(compressed)));
        }

        window.loadBase64 = function(b64) {
            let data = JSON.parse(decodeURIComponent(atob(b64)));
            initBlankGrid();
            for(let item of data) {
                if(item.r < ROWS && item.c < COLS) {
                    grid[item.r][item.c] = {
                        char: item.char,
                        color: item.color,
                        reverse: item.reverse,
                        underline: item.underline,
                        blink: item.blink
                    };
                }
            }
            renderAll();
            setCursor(0, 0);
        }

        window.openExportModal = function() {
            document.getElementById('export-textarea').value = generateBase64();
            openModal('modal-export');
        }

        window.copyExport = function() {
            const ta = document.getElementById('export-textarea');
            ta.select();
            document.execCommand('copy');
            closeModal('modal-export');
            showToast("Encoded code copied to clipboard!");
        }

        window.openImportModal = function() {
            document.getElementById('import-textarea').value = '';
            openModal('modal-import');
            document.getElementById('import-textarea').focus();
        }

        window.importCode = function() {
            const b64 = document.getElementById('import-textarea').value.trim();
            if(!b64) return;
            try {
                loadBase64(b64);
                closeModal('modal-import');
                showToast("Design imported successfully!");
            } catch(e) {
                alert("Invalid encoding format.");
            }
        }

        // PNG Export using Canvas
        window.exportPNG = function() {
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            const charW = 12;
            const charH = 24;
            canvas.width = COLS * charW;
            canvas.height = ROWS * charH;
            
            ctx.fillStyle = '#000';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            
            ctx.font = '20px "Courier New", monospace';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            
            for(let r=0; r<ROWS; r++){
                for(let c=0; c<COLS; c++){
                    let cell = grid[r][c];
                    let x = c * charW;
                    let y = r * charH;
                    
                    let bg = cell.reverse ? cell.color : '#000';
                    let fg = cell.reverse ? '#000' : cell.color;
                    
                    if (bg !== '#000') {
                        ctx.fillStyle = bg;
                        ctx.fillRect(x, y, charW, charH);
                    }
                    
                    if (cell.char !== ' ') {
                        ctx.fillStyle = fg;
                        if (cell.char === '_') {
                            ctx.fillRect(x, y + charH - 2, charW, 2);
                        } else {
                            ctx.fillText(cell.char, x + charW/2, y + charH/2 + 2);
                        }
                    }
                    
                    if (cell.underline && cell.char !== '_') {
                        ctx.fillStyle = fg;
                        ctx.fillRect(x, y + charH - 1, charW, 1);
                    }
                }
            }
            
            const link = document.createElement('a');
            link.download = 'as400_layout.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
            showToast("PNG downloaded!");
        }

        // Boot App
        init();

    </script>
</div>
