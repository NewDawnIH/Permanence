    <div id="toast-container"></div>

    <script>
        // Data Structure & Storage
        let todos = [];
        let currentEditId = null;
        let currentTab = 'active';

        const ICONS = {
            importantFill: '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>',
            importantOutline: '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M22 9.24l-7.19-.62L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.63-7.03L22 9.24zM12 15.4l-3.76 2.27 1-4.28-3.32-2.88 4.38-.38L12 6.1l1.71 4.04 4.38.38-3.32 2.88 1 4.28L12 15.4z"/></svg>',
            calendar: '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg>',
            check: '<svg viewBox="0 0 24 24" style="width: 32px; height: 32px;"><path fill="currentColor" d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/></svg>'
        };

        function init() {
            try {
                const stored = localStorage.getItem('td_data');
                if (stored) todos = JSON.parse(stored);
            } catch (e) {
                console.warn("localStorage is restricted, using in-memory state.");
                showToast("Running in secure mode (data won't save after reload)");
            }
            render();
        }

        function saveState() {
            try {
                localStorage.setItem('td_data', JSON.stringify(todos));
            } catch (e) {
                // Silently fail if localStorage is restricted
            }
        }

        // Global Keyboard Shortcut
        document.addEventListener('keydown', (e) => {
            if ((e.key === 'n' || e.key === 'N') && 
                !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName) &&
                !document.getElementById('edit-dialog').open &&
                !document.getElementById('remark-dialog').open) {
                e.preventDefault();
                openDialog();
            }
        });

        // UI Interactions
        function switchTab(tab) {
            currentTab = tab;
            document.getElementById('tab-active').classList.toggle('active', tab === 'active');
            document.getElementById('tab-completed').classList.toggle('active', tab === 'completed');
            
            document.getElementById('view-active').style.display = tab === 'active' ? 'block' : 'none';
            document.getElementById('view-completed').style.display = tab === 'completed' ? 'block' : 'none';
            
            // Hide FAB on completed tab
            document.getElementById('fab-add').style.display = tab === 'active' ? 'flex' : 'none';
            render();
        }

        function showToast(msg) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.textContent = msg;
            container.appendChild(toast);
            
            requestAnimationFrame(() => {
                requestAnimationFrame(() => toast.classList.add('show'));
            });

            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function generateId() {
            return Date.now().toString(36) + Math.random().toString(36).substr(2);
        }

        // Rendering logic
        function render() {
            const activeTodos = todos.filter(t => !t.completed);
            const completedTodos = todos.filter(t => t.completed).sort((a, b) => b.completedAt - a.completedAt);

            if (currentTab === 'active') {
                const withDate = activeTodos.filter(t => t.dueDate).sort((a, b) => new Date(a.dueDate) - new Date(b.dueDate));
                const withoutDate = activeTodos.filter(t => !t.dueDate);

                renderList('upcoming-list', withDate);
                renderList('someday-list', withoutDate);

                document.getElementById('upcoming-section').style.display = withDate.length > 0 ? 'block' : 'none';
                document.getElementById('someday-section').style.display = withoutDate.length > 0 ? 'block' : 'none';
                document.getElementById('active-empty').style.display = activeTodos.length === 0 ? 'block' : 'none';
            } else {
                renderList('completed-list', completedTodos, true);
                document.getElementById('completed-empty').style.display = completedTodos.length === 0 ? 'block' : 'none';
            }
        }

        function renderList(containerId, list, isCompletedView = false) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';

            list.forEach(todo => {
                const swipeContainer = document.createElement('div');
                swipeContainer.className = 'swipe-container';
                swipeContainer.dataset.id = todo.id;

                let dateHtml = '';
                if (todo.dueDate) {
                    const d = new Date(todo.dueDate);
                    const dateStr = d.toLocaleDateString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
                    dateHtml = `<div class="chip">${ICONS.calendar} ${dateStr}</div>`;
                }

                let remarksHtml = '';
                if (isCompletedView && todo.remarks) {
                    remarksHtml = `<div class="body-medium" style="color: var(--on-surface-variant); margin-top: 8px; border-left: 2px solid var(--outline-variant); padding-left: 8px;">${todo.remarks}</div>`;
                }

                const bgHtml = isCompletedView ? '' : `
                    <div class="swipe-background">
                        ${ICONS.check}
                    </div>
                `;

                swipeContainer.innerHTML = `
                    ${bgHtml}
                    <div class="todo-card" ${isCompletedView ? '' : 'style="touch-action: pan-y;"'}>
                        <div class="card-header">
                            <div class="card-title ${isCompletedView ? 'completed-text' : ''}">
                                ${todo.title}
                            </div>
                            ${todo.important ? `<div class="important-icon">${ICONS.importantFill}</div>` : ''}
                        </div>
                        <div class="card-meta">
                            ${dateHtml}
                        </div>
                        ${remarksHtml}
                    </div>
                `;

                const card = swipeContainer.querySelector('.todo-card');
                
                // Click to edit
                card.addEventListener('click', (e) => {
                    // Prevent click if we were swiping
                    if (card.dataset.swiping === 'true') return;
                    if (isCompletedView) {
                        openRemarkDialog(todo.id);
                    } else {
                        openDialog(todo.id);
                    }
                });

                if (!isCompletedView) {
                    attachSwipeHandler(swipeContainer, card, todo.id);
                }

                container.appendChild(swipeContainer);
            });
        }

        // Swipe Logic
        function attachSwipeHandler(container, card, id) {
            let startX = 0;
            let startY = 0;
            let currentX = 0;
            let isDragging = false;
            let isScrolling = false;
            const bg = container.querySelector('.swipe-background');

            const handleStart = (clientX, clientY) => {
                startX = clientX;
                startY = clientY;
                isDragging = true;
                isScrolling = false;
                card.style.transition = 'none';
                bg.style.transition = 'none';
                card.dataset.swiping = 'false';
            };

            const handleMove = (clientX, clientY, e) => {
                if (!isDragging) return;
                
                const dx = clientX - startX;
                const dy = clientY - startY;

                // Detect scroll intention
                if (Math.abs(dy) > Math.abs(dx) && currentX === 0) {
                    isDragging = false;
                    isScrolling = true;
                    return;
                }

                if (isScrolling) return;

                if (dx > 0) { // Only swipe right
                    currentX = dx;
                    card.style.transform = `translateX(${dx}px)`;
                    bg.style.opacity = Math.min(1, dx / 150);
                    card.dataset.swiping = 'true';
                    if (e && e.cancelable) e.preventDefault();
                }
            };

            const handleEnd = () => {
                if (!isDragging) return;
                isDragging = false;
                
                card.style.transition = 'transform 0.3s cubic-bezier(0.2, 0, 0, 1)';
                bg.style.transition = 'opacity 0.3s';

                if (currentX > 100) {
                    // Trigger complete
                    card.style.transform = `translateX(100%)`;
                    bg.style.opacity = 1;
                    setTimeout(() => completeTask(id), 300);
                } else {
                    // Snap back
                    card.style.transform = `translateX(0)`;
                    bg.style.opacity = 0;
                }
                
                // Delay removing swiping state to prevent click event
                setTimeout(() => {
                    currentX = 0;
                    card.dataset.swiping = 'false';
                }, 50);
            };

            // Touch events
            container.addEventListener('touchstart', e => handleStart(e.touches[0].clientX, e.touches[0].clientY), {passive: true});
            container.addEventListener('touchmove', e => handleMove(e.touches[0].clientX, e.touches[0].clientY, e), {passive: false});
            container.addEventListener('touchend', handleEnd);

            // Pointer/Mouse events for desktop
            container.addEventListener('mousedown', e => {
                if (e.button !== 0) return; // Left click only
                handleStart(e.clientX, e.clientY);
            });
            document.addEventListener('mousemove', e => {
                if(isDragging) handleMove(e.clientX, e.clientY, e);
            });
            document.addEventListener('mouseup', () => {
                if(isDragging) handleEnd();
            });
        }

        // CRUD Operations
        function completeTask(id) {
            const index = todos.findIndex(t => t.id === id);
            if (index > -1) {
                todos[index].completed = true;
                todos[index].completedAt = Date.now();
                saveState();
                render();
                showToast("Task completed. Swipe to greatness!");
            }
        }

        function uncompleteTodo() {
            if (!currentEditId) return;
            const index = todos.findIndex(t => t.id === currentEditId);
            if (index > -1) {
                todos[index].completed = false;
                todos[index].completedAt = null;
                saveState();
                closeRemarkDialog();
                render();
                showToast("Task moved back to active.");
            }
        }

        // Add / Edit Dialog logic
        const dialog = document.getElementById('edit-dialog');
        const remarkDialog = document.getElementById('remark-dialog');

        function openDialog(id = null) {
            currentEditId = id;
            const titleInput = document.getElementById('todo-title');
            const dateInput = document.getElementById('todo-date');
            const impSwitch = document.getElementById('todo-important');
            const delBtn = document.getElementById('btn-delete');
            const header = document.getElementById('dialog-title');

            if (id) {
                const todo = todos.find(t => t.id === id);
                header.textContent = "Edit To Do";
                titleInput.value = todo.title;
                dateInput.value = todo.dueDate || '';
                impSwitch.classList.toggle('active', todo.important);
                delBtn.style.display = 'block';
            } else {
                header.textContent = "New To Do";
                titleInput.value = '';
                dateInput.value = '';
                impSwitch.classList.remove('active');
                delBtn.style.display = 'none';
            }
            dialog.showModal();
            // Small delay for focus so animation is smooth
            setTimeout(() => titleInput.focus(), 100);
        }

        function closeDialog() {
            dialog.close();
            currentEditId = null;
        }

        function saveTodo() {
            const title = document.getElementById('todo-title').value.trim();
            if (!title) {
                showToast("Task description is required");
                return;
            }

            const dueDate = document.getElementById('todo-date').value;
            const important = document.getElementById('todo-important').classList.contains('active');

            if (currentEditId) {
                const index = todos.findIndex(t => t.id === currentEditId);
                todos[index] = { ...todos[index], title, dueDate, important };
                showToast("Task updated");
            } else {
                todos.push({
                    id: generateId(),
                    title,
                    dueDate: dueDate || null,
                    important,
                    completed: false,
                    remarks: "",
                    createdAt: Date.now(),
                    completedAt: null
                });
                showToast("Task created");
            }

            saveState();
            closeDialog();
            render();
        }

        function deleteTodo() {
            if (!currentEditId) return;
            todos = todos.filter(t => t.id !== currentEditId);
            saveState();
            closeDialog();
            render();
            showToast("Task deleted");
        }

        // Remarks Dialog Logic
        function openRemarkDialog(id) {
            currentEditId = id;
            const todo = todos.find(t => t.id === id);
            document.getElementById('remark-title').value = todo.title;
            document.getElementById('remark-text').value = todo.remarks || '';
            remarkDialog.showModal();
        }

        function closeRemarkDialog() {
            remarkDialog.close();
            currentEditId = null;
        }

        function saveRemark() {
            if (!currentEditId) return;
            const index = todos.findIndex(t => t.id === currentEditId);
            
            const newTitle = document.getElementById('remark-title').value.trim();
            if(!newTitle) { showToast("Title cannot be empty"); return; }

            todos[index].title = newTitle;
            todos[index].remarks = document.getElementById('remark-text').value.trim();
            
            saveState();
            closeRemarkDialog();
            render();
            showToast("Remarks saved");
        }

        function deleteTodoFromRemark() {
            if (!currentEditId) return;
            todos = todos.filter(t => t.id !== currentEditId);
            saveState();
            closeRemarkDialog();
            render();
            showToast("Task deleted");
        }

        // Initialize App
        window.onload = init;

    </script>
</body>
</html>
